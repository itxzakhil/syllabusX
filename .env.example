# ============================================================
# College Assessment - Registration Verification Settings
# ============================================================
# Copy these values into your Windows environment before starting Flask.

# OTP lifetime / resend protection
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60

# ---------------- EMAIL (SMTP) ----------------
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=yourcollegeemail@gmail.com
# SMTP_PASSWORD=your_16_character_google_app_password
# SMTP_FROM=yourcollegeemail@gmail.com
# SMTP_USE_SSL=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=0

# ---------------- MOBILE VERIFICATION ----------------
# Development mode: no SMS provider is required.
# The mobile OTP is printed to the Flask server console.
# Twilio variables are intentionally unused in this development build.
